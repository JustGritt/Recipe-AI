---
const { href, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;
const isActive = href === pathname || pathname.startsWith(href + '/');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}
	class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors px-4 py-2 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800">
	<slot />
</a>

<style scoped>
	a.active {
		color: #111827;
		font-weight: 600;
	}

	.dark a.active {
		color: #ffffff;
		font-weight: 600;
	}
</style>

