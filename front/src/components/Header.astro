---
import HeaderLink from './HeaderLink.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { SITE_TITLE } from '@consts';
---

<header class="fixed w-full bg-white/80 dark:bg-gray-900/95 backdrop-blur-md border-b border-gray-100 dark:border-gray-800 z-50 transition-colors">
	<nav class="max-w-7xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between">
		<!-- Logo -->
		<a href="/" class="text-xl font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors">{SITE_TITLE}</a>

		<!-- Main nav -->
		<div class="hidden md:flex items-center gap-8">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/recipe">Recipes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<!-- Side links -->
		<div id="sideLinks" class="flex items-center gap-3">
			<DarkModeToggle />
		</div>
	</nav>
</header>

<!-- Mobile nav -->
<div class="fixed bottom-0 left-0 w-full bg-white/95 dark:bg-gray-900/98 backdrop-blur-md border-t border-gray-200 dark:border-gray-800 md:hidden z-40 transition-colors">
	<div class="flex justify-around items-center h-16 px-4">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/recipe">Recipes</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
	</div>
</div>

<script>
	const createLoggedOffMenu = () => {
		const loginLink = document.createElement('a');
		loginLink.classList.add('text-sm', 'font-medium', 'text-gray-600', 'dark:text-gray-300', 'hover:text-gray-900', 'dark:hover:text-white', 'transition-colors', 'px-4', 'py-2', 'rounded-xl', 'hover:bg-gray-100', 'dark:hover:bg-gray-800');
		loginLink.href = '/login';
		loginLink.textContent = 'Sign in';

		const registerLink = document.createElement('a');
		registerLink.classList.add('text-sm', 'font-medium', 'bg-gray-900', 'dark:bg-white', 'text-white', 'dark:text-gray-900', 'hover:bg-gray-700', 'dark:hover:bg-gray-200', 'transition-colors', 'px-4', 'py-2', 'rounded-xl', 'hover:text-white');
		registerLink.href = '/register';
		registerLink.textContent = 'Get Started';

		sideLinks.appendChild(loginLink);
		sideLinks.appendChild(registerLink);
	}

	const createLoggedInMenu = () => {
		const dashboardLink = document.createElement('a');
		dashboardLink.classList.add('text-sm', 'font-medium', 'text-gray-600', 'dark:text-gray-300', 'hover:text-gray-900', 'dark:hover:text-white', 'transition-colors', 'px-4', 'py-2', 'rounded-xl', 'hover:bg-gray-100', 'dark:hover:bg-gray-800');
		dashboardLink.href = '/dashboard';
		dashboardLink.textContent = 'Dashboard';

		const logoutLink = document.createElement('a');
		logoutLink.classList.add('text-sm', 'font-medium', 'text-gray-600', 'dark:text-gray-300', 'hover:text-gray-900', 'dark:hover:text-white', 'transition-colors', 'px-4', 'py-2', 'rounded-xl', 'hover:bg-gray-100', 'dark:hover:bg-gray-800');
		logoutLink.href = '/logout';
		logoutLink.textContent = 'Sign out';

		sideLinks.appendChild(dashboardLink);
		sideLinks.appendChild(logoutLink);
	}

	const token = localStorage.getItem('jwt') || null;
	const sideLinks = document.getElementById('sideLinks') as HTMLDivElement;
	if (token) {
		const req = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/verify`, {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				'Authorization': `Bearer ${import.meta.env.PUBLIC_OPENAI}`
			},
			body: JSON.stringify({ token }),
		});
		await req.json().then((res) => {
			if (res.status === 'success') {
				createLoggedInMenu();
			} else {
				createLoggedOffMenu();
			}
		})
	} else {
		createLoggedOffMenu();
	}
</script>