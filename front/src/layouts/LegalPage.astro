---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE_TITLE } from '../consts';

interface Props {
    title: string;
    description: string;
    lastUpdated?: Date;
}

const { title, description, lastUpdated } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <BaseHead title={`${title} - ${SITE_TITLE}`} description={description} />
    </head>
    <body class="flex flex-col min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors">
        <Header title={SITE_TITLE} />
        <main class="flex-grow w-full pt-16 pb-16 md:pb-24">
            <article class="max-w-3xl mx-auto px-6 lg:px-8 py-12 md:py-20">
                <header class="mb-16 text-center pb-12 border-b-2 border-gray-200 dark:border-gray-800">
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight leading-tight">
                        {title}
                    </h1>
                    {lastUpdated && (
                        <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                            Last updated: {lastUpdated.toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            })}
                        </p>
                    )}
                </header>

                <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
                    <slot />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>

<style>
    .prose {
        @apply text-gray-600 dark:text-gray-300 leading-loose;
        font-size: 1.0625rem;
        line-height: 1.875;
    }

    .prose h2 {
        @apply text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 pb-3 border-b border-gray-200 dark:border-gray-800;
        letter-spacing: -0.02em;
        line-height: 1.3;
    }

    .prose h3 {
        @apply text-xl md:text-2xl font-semibold text-gray-900 dark:text-white mt-12 mb-5;
        letter-spacing: -0.01em;
        line-height: 1.4;
    }

    .prose p {
        @apply mb-8 text-gray-600 dark:text-gray-300;
        line-height: 1.875;
    }

    .prose p.text-lg {
        @apply text-xl text-gray-700 dark:text-gray-200 mb-12 leading-relaxed;
        line-height: 1.8;
    }

    .prose ul, .prose ol {
        @apply mb-10 pl-6 space-y-4;
    }

    .prose li {
        @apply text-gray-600 dark:text-gray-300 leading-loose;
        line-height: 1.875;
        padding-left: 0.5rem;
    }

    .prose li::marker {
        @apply text-gray-400 dark:text-gray-600;
    }

    .prose a {
        @apply text-gray-900 dark:text-white font-medium underline decoration-2 underline-offset-2 hover:text-gray-600 dark:hover:text-gray-300 transition-colors;
    }

    .prose strong {
        @apply font-semibold text-gray-900 dark:text-white;
    }

    /* Section spacing */
    .prose > section {
        @apply space-y-8;
    }

    /* First paragraph after heading */
    .prose h2 + p,
    .prose h3 + p {
        @apply mt-6;
    }
</style>
