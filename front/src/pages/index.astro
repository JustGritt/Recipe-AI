---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Chat from '@components/Chat.astro';
import SearchBar from '@components/SearchBar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="flex flex-col min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors">
        <Header title={SITE_TITLE} />
        <main id="home" class="bg-white flex-grow w-full pt-16 pb-24 md:pb-12">
            <section class="max-w-5xl mx-auto px-6 lg:px-8">
                <div class="text-center pt-16 pb-12 md:pt-24 md:pb-16">
                    <h1 class="text-4xl md:text-6xl font-bold text-slate-900 dark:text-white mb-6 tracking-tight">
                        Discover Your Next Culinary Adventure
                    </h1>
                    <p class="text-lg md:text-xl text-slate-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto">
                        Generate personalized recipes powered by AI. Just describe what you're craving, and we'll create the perfect dish for you.
                    </p>
                    <SearchBar />
                </div>
                <Chat />
            </section>
        </main>
        <Footer />
    </body>
</html>