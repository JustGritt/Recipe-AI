---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Chat from '@components/Chat.astro';

import Lightbulb from '@icons/Lightbulb.astro';
import User from '@icons/User.astro';
import Terminal from '@icons/Terminal.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900 transition-colors">
		<Header title={SITE_TITLE} />
		<main id="home" class="flex-grow w-full m-0 max-w-full transition-colors">
			<section class="max-w-6xl m-auto px-6 lg:px-8 py-20">
				<div class="container mx-auto">
					<div class="text-center mb-16">
						<h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">
							Recipe AI
						</h1>
						<p class="text-lg md:text-xl leading-relaxed max-w-3xl mx-auto text-gray-600 dark:text-gray-400">
							A small project that uses AI to generate recipes. Type in ingredients or a dish and get a complete recipe with steps, duration, and difficulty level.
						</p>
						<div class="flex mt-8 justify-center">
							<div class="w-16 h-1 rounded-full bg-gray-900 dark:bg-white"></div>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
						<div
							class="p-8 flex flex-col text-center items-center bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 transition-all duration-200 hover:border-gray-400 dark:hover:border-gray-600 hover:shadow-lg group">
							<div
								class="w-20 h-20 inline-flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 mb-5 flex-shrink-0 group-hover:bg-gray-200 dark:group-hover:bg-gray-600 transition-all duration-200">
								<Lightbulb />
							</div>
							<div class="flex-grow">
								<h2 class="text-gray-900 dark:text-white text-xl font-semibold mb-3">Easy to use</h2>
								<p class="leading-relaxed text-gray-600 dark:text-gray-400">
									A simple interface that allows you to generate recipes with ease. Just type in the
									ingredients or dish and let the AI do the rest.
								</p>
							</div>
						</div>

						<div
							class="p-8 flex flex-col text-center items-center bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 transition-all duration-200 hover:border-gray-400 dark:hover:border-gray-600 hover:shadow-lg group">
							<div
								class="w-20 h-20 inline-flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 mb-5 flex-shrink-0 group-hover:bg-gray-200 dark:group-hover:bg-gray-600 transition-all duration-200">
								<User />
							</div>
							<div class="flex-grow">
								<h2 class="text-gray-900 dark:text-white text-xl font-semibold mb-3">Recipe Assistant</h2>
								<p class="leading-relaxed text-gray-600 dark:text-gray-400">
									If you have any questions about a recipe, you can ask the assistant and it will help
									you in any way it can.
								</p>
							</div>
						</div>

						<div
							class="p-8 flex flex-col text-center items-center bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 transition-all duration-200 hover:border-gray-400 dark:hover:border-gray-600 hover:shadow-lg group">
							<div
								class="w-20 h-20 inline-flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 mb-5 flex-shrink-0 group-hover:bg-gray-200 dark:group-hover:bg-gray-600 transition-all duration-200">
								<Terminal />
							</div>
							<div class="flex-grow">
								<h2 class="text-gray-900 dark:text-white text-xl font-semibold mb-3">Self hosting</h2>
								<p class="leading-relaxed text-gray-600 dark:text-gray-400">
									You can host this project on your own server and use your own API key to generate
									recipes. Using local LLM models is also possible.
								</p>
								<a href="https://github.com/JustGritt/Recipe-AI" target="_blank"
									class="mt-4 text-gray-900 dark:text-white font-medium inline-flex items-center transition-colors duration-200 hover:underline">Learn
									More
									<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
										stroke-width="2" class="w-4 h-4 ml-2" viewBox="0 0 24 24">
										<path d="M5 12h14M12 5l7 7-7 7"></path>
									</svg>
								</a>
							</div>
						</div>

					</div>
				</div>

				<Chat />
			</section>
		</main>
		<Footer />
	</body>
</html>