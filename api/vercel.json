{
    "version": 2,
    "functions": {
        "server.js": {
            "runtime": "nodejs20.x"
        }
    },
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ]
}